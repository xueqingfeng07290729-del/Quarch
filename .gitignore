# Local Python environment and third-party runtime/source downloads.
/.venv/
/QuarchPy/
/downloads/
__pycache__/
*.py[cod]

# Local measurement output stays ignored; curated experiments/ archives are tracked.
/*.csv
/*.energy.json
/measure_analysis/
/data/raw/
/results/
/validation/

# Local credentials and runtime logs.
.env
.env.*
*.log

# Database payloads are supplied locally, not published with experiment summaries.
*.duckdb
*.duckdb.wal
